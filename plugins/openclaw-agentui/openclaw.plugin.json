{
  "id": "agentui",
  "channels": ["agentui"],
  "contracts": { "tools": ["agentui_chart", "agentui_map", "agentui_code", "agentui_table", "agentui_progress", "agentui_image", "agentui_ask", "agentui_confirm", "agentui_form"] },
  "name": "AgentUI",
  "description": "AgentUI channel: OpenClaw connects to AgentUI (outgoing WebSocket) using the AgentUI Channel Protocol v1.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "channelConfigs": {
    "agentui": {
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean" },
          "url": { "type": "string", "description": "WebSocket URL of the AgentUI gateway (wss://…/gateway)" },
          "token": { "type": "string" },
          "name": { "type": "string", "description": "Name displayed in AgentUI (default: OpenClaw)" }
        }
      },
      "uiHints": {
        "url": { "label": "URL AgentUI" },
        "token": { "label": "Token AgentUI", "sensitive": true },
        "name": { "label": "Display name" }
      }
    }
  }
}
